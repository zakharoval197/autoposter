# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF-your-bot-token
CHANNEL_ID=@kuda_skid_msk
ADMIN_ID=123456789
CHANNEL_NAME=Куда сходить в Москве

# --- LLM: GigaChat (Сбер) — основной, бесплатный для физлиц ---
# Authorization key из developers.sber.ru → проект GigaChat API
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- LLM: Kimi API, OpenAI-совместимый (запасной) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-latest
# temperature — только если нужна нестандартная; kimi-k2 принимает строго 1
# KIMI_TEMPERATURE=1

# --- Kandinsky (FusionBrain) — fallback генерация обложек ---
KANDINSKY_API_KEY=
KANDINSKY_SECRET_KEY=

# --- Хранение и логи ---
DB_PATH=data/events.db
LOG_LEVEL=INFO
